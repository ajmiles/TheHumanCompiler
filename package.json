{
  "name": "humancompiler",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.verifier.config.ts",
    "preview": "vite preview",
    "test": "tsx tests/test_all.ts",
    "test:verifier": "tsx tests/verifier_quickjs.ts",
    "hw-job": "tsx scripts/hw-job.ts",
    "emulators": "npx --yes firebase-tools@15 emulators:start --only auth,firestore --project demo-human-compiler",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project demo-human-compiler \"tsx tests/firestore_rules.test.ts\"",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch(e){}\""
  },
  "keywords": [],
