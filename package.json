  "devDependencies": {
    "@jitl/quickjs-ng-wasmfile-release-sync": "^0.32.0",
    "monaco-editor": "^0.55.1",
    "quickjs-emscripten-core": "^0.32.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  },
  "dependencies": {
    "firebase": "^12.11.0"
  }
}
