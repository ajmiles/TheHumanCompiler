rules_version = '2';

// Firestore security rules for the online leaderboards written by
// src/firebase/online-leaderboard.ts, for the devkit that times submitted
// solutions on hardware (src/hardware), and for sandbox code shared by link
// (src/firebase/shares.ts). Rules and indexes are deployed by hand:
//   firebase deploy --only firestore:rules,firestore:indexes --project human-compiler
//
// A player has one entry on each puzzle's board, their best in each category,
// under a name they own. Scores are still reported by the client: these rules
// only enforce the document shape, plausible value ranges, ownership and that a
// best never gets worse. The devkit re-checks a submitted solution in the
// emulator before timing it.
service cloud.firestore {
  match /databases/{database}/documents {

    // A player's entry on a puzzle's board, under their uid: their best code
    // size, VGPRs and cycles (each may come from a different solution), and the
    // devkit's best time for them as hw.
    match /leaderboards/{puzzleId}/entries/{uid} {
      // Leaderboards are public.
      allow read: if true;

      // The player's first score on the puzzle, under the name they own.
      allow create: if isValidPuzzleId(puzzleId)
                    && isOwner(uid)
                    && isValidEntry(uid, request.resource.data)
                    && !('hw' in request.resource.data);

      // A later score: no category gets worse (the client keeps the best of
      // each), and the name is the player's (it changes when they rename).
      allow update: if isOwner(uid)
                    && isValidEntry(uid, request.resource.data)
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['uid', 'hw'])
                    && request.resource.data.codeSize <= resource.data.codeSize
                    && request.resource.data.vgprsUsed <= resource.data.vgprsUsed
                    && request.resource.data.cycles <= resource.data.cycles;

      // Only the devkit adds its timing, as hw.
      allow update: if isRunner()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hw'])
                    && isValidHardwareResult(request.resource.data.hw);

      // Players may delete only their own.
      allow delete: if isOwner(uid);
    }

    // A player's name. The name is theirs (names/{nameKey}) in the same batch
    // that sets it; changing it gives up the old one in that batch too.
    match /players/{uid} {
      allow read: if true;
      allow create: if isOwner(uid) && isValidPlayer(uid, request.resource.data);
      allow update: if isOwner(uid)
                    && isValidPlayer(uid, request.resource.data)
                    && (request.resource.data.nameKey == resource.data.nameKey
                        || !existsAfter(/databases/$(database)/documents/names/$(resource.data.nameKey)));
    }

    // Who owns each name, under the name in lower case: names are unique
    // whatever their case. A player claims one only with their players
    // document naming it, and gives one up only for another.
    match /names/{key} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.nameKey == key;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/players/$(request.auth.uid)).data.nameKey != key;
    }

    // The source of a solution for the devkit to time: private to its author
    // and the devkit. Submitted with a score, it carries the stats it scored,
    // for the player's entry on its puzzle. A run of the player's own, which
    // goes on no board, is trial-{uid}: one a player, replaced by the next.
    match /submissions/{id} {
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid || isRunner());
      allow create: if isValidSubmission(id, request.resource.data)
                    || isValidTrial(id, request.resource.data);
      // The player runs another solution: the devkit's record of the last one goes with it.
      allow update: if isValidTrial(id, request.resource.data);
      // The devkit records how timing the solution went.
      allow update: if isRunner()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'detail', 'cycles', 'claimMismatches', 'harness', 'updatedAt'])
                    && request.resource.data.status in ['running', 'measured', 'failed', 'unstable', 'rejected', 'stale', 'hung'];
      // Deleting one that isn't there is allowed (and does nothing), so that
      // deleting scores can always delete their submissions too.
      allow delete: if request.auth != null
                    && (resource == null || resource.data.uid == request.auth.uid);
    }

    // The devkit's heartbeat, public so that the site can show whether it's online.
    match /runner/status {
      allow read: if true;
      allow write: if isRunner();
    }

    // Sandbox code shared by link (the Share button). Anyone with a link reads
    // its share, but nobody can list them; a share is never changed or deleted,
    // so an id that's taken can't be written again.
    match /shares/{id} {
      allow get: if true;
      allow create: if request.auth != null
                    && id.matches('[0-9A-Za-z]{8}')
                    && isValidShare(request.resource.data);
    }

    // The devkit's account: an email/password user (devkit-runner@human-compiler.invalid),
    // made for the runner on 1 November 2026. Nobody else is the runner.
    function isRunner() {
      return request.auth != null && request.auth.uid == 'XuEZIuVLMGYbBfPNWOSHRAZbOIE2';
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Puzzle ids are slugs such as 'signal-boost' (see src/puzzle/puzzles.ts).
    function isValidPuzzleId(id) {
      return id.matches('[A-Za-z0-9_-]{1,64}');
    }

    // A player's name: what the UI's <input maxlength="20"> takes, trimmed and
    // not empty, and usable in lower case as a document id (no '/', not '.',
    // '..' or __reserved__).
    function isValidName(name) {
      return name is string
        && name.size() <= 20
        && name.size() > 0
        && name == name.trim()
        && !name.matches('.*/.*')
        && !name.matches('[.]{1,2}')
        && !name.lower().matches('__.*__');
    }

    function isValidPlayer(uid, data) {
      return data.keys().hasAll(['name', 'nameKey'])
        && data.keys().hasOnly(['name', 'nameKey'])
        && isValidName(data.name)
        && data.nameKey == data.name.lower()
        && getAfter(/databases/$(database)/documents/names/$(data.nameKey)).data.uid == uid;
    }

    // What submitOnlineScore() writes. codeSize is in bytes (whole 32-bit
    // dwords); timestamp is Date.now() in milliseconds, allowing up to a day of
    // client clock skew. The name is the player's, after the batch the entry
    // comes in (which may claim it).
    function isValidEntry(uid, data) {
      let fields = ['uid', 'name', 'codeSize', 'vgprsUsed', 'cycles', 'timestamp'];
      return data.keys().hasAll(fields)
        && data.keys().hasOnly(fields.concat(['hw']))
        && data.uid == uid
        && data.name == getAfter(/databases/$(database)/documents/players/$(uid)).data.name
        && isValidStats(data)
        && data.timestamp is int
        && data.timestamp > 0
        && data.timestamp <= request.time.toMillis() + 24 * 60 * 60 * 1000;
    }

    // A solution's stats, as the game measured them.
    function isValidStats(s) {
      return s.codeSize is int
        && s.codeSize >= 4
        && s.codeSize <= 65536
        && s.codeSize % 4 == 0
        && s.vgprsUsed is int
        && s.vgprsUsed >= 1
        && s.vgprsUsed <= 256
        && s.cycles is int
        && s.cycles >= 1
        && s.cycles <= 10000000;
    }

    // A solution's source as src/firebase/online-leaderboard.ts uploads it,
    // waiting for the devkit, with any `extra` fields.
    function isValidSource(data, extra) {
      let fields = ['uid', 'puzzleId', 'source', 'appVersion', 'puzzleHash', 'createdAt', 'status'].concat(extra);
      return request.auth != null
        && data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.uid == request.auth.uid
        && data.puzzleId is string
        && isValidPuzzleId(data.puzzleId)
        && data.source is string
        && data.source.size() > 0
        && data.source.size() <= 100000
        && data.appVersion is string
        && data.appVersion.matches('[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}')
        && data.puzzleHash is string
        && data.puzzleHash.matches('[0-9a-f]{16}')
        && data.createdAt == request.time
        && data.status == 'pending';
    }

    // A scored solution (submitOnlineScore()): its source and the stats it
    // scored, for the player's own entry on its puzzle, which must exist after
    // the batch it comes in. Any id but a trial's.
    function isValidSubmission(id, data) {
      return isValidSource(data, ['stats'])
        && !id.matches('trial-.*')
        && data.stats is map
        && data.stats.keys().hasOnly(['codeSize', 'vgprsUsed', 'cycles'])
        && isValidStats(data.stats)
        && existsAfter(/databases/$(database)/documents/leaderboards/$(data.puzzleId)/entries/$(request.auth.uid));
    }

    // The player's own run (runOnDevkit()), which goes on no board.
    function isValidTrial(id, data) {
      return isValidSource(data, []) && id == 'trial-' + request.auth.uid;
    }

    // What the devkit adds to an entry once it has timed the solution (the
    // measured fields of HwScore in src/hardware/protocol.ts), and submittedAt:
    // the submission's createdAt, which breaks ties on the board (the entry's
    // own timestamp is the player's clock).
    function isValidHardwareResult(hw) {
      return hw is map
        && hw.keys().hasAll(['cycles', 'harness', 'measuredAt', 'submittedAt'])
        && hw.keys().hasOnly(['cycles', 'perInvocation', 'emulatorMismatches', 'harness', 'measuredAt', 'submittedAt'])
        && hw.cycles is int
        && hw.cycles >= 0
        && hw.harness is int
        && hw.measuredAt is timestamp
        && hw.submittedAt is timestamp;
    }

    // What createShare() (src/firebase/shares.ts) writes: the sandbox's code,
    // up to MAX_SHARE_CHARS (src/puzzle/share.ts), and the game it came from.
    function isValidShare(data) {
      return data.keys().hasAll(['source', 'appVersion', 'createdAt'])
        && data.keys().hasOnly(['source', 'appVersion', 'createdAt'])
        && data.source is string
        && data.source.size() > 0
        && data.source.size() <= 50000
        && data.appVersion is string
        && data.appVersion.matches('[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}')
        && data.createdAt == request.time;
    }

    // Everything else is denied: there are no other allow rules.
  }
}
