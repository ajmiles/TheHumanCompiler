rules_version = '2';

// Firestore security rules for the online leaderboards written by
// src/firebase/online-leaderboard.ts, and for the devkit that times submitted
// solutions on hardware (src/hardware). Rules and indexes are deployed by hand:
//   firebase deploy --only firestore:rules,firestore:indexes --project human-compiler
//
// Scores are still reported by the client: these rules only enforce the
// document shape, plausible value ranges and ownership. The devkit re-checks a
// submitted solution in the emulator before timing it.
service cloud.firestore {
  match /databases/{database}/documents {

    match /leaderboards/{puzzleId}/entries/{entryId} {
      // Leaderboards are public.
      allow read: if true;

      // Signed-in (anonymous) players may add well-formed entries as themselves.
      allow create: if isValidPuzzleId(puzzleId)
                    && isValidNewEntry(request.resource.data);

      // Players can't change entries; the devkit adds its timing to them as hw.
      allow update: if isRunner()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hw'])
                    && isValidHardwareResult(request.resource.data.hw);
      // Players may delete only their own.
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // The source of a submitted solution, under the id of its leaderboard
    // entry: private to its author and the devkit.
    match /submissions/{entryId} {
      allow read: if request.auth != null
                  && (resource.data.uid == request.auth.uid || isRunner());
      allow create: if isValidSubmission(entryId, request.resource.data);
      // The devkit records how timing the solution went.
      allow update: if isRunner()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'detail', 'cycles', 'claimMismatches', 'harness', 'updatedAt'])
                    && request.resource.data.status in ['running', 'measured', 'failed', 'unstable', 'rejected', 'stale', 'hung'];
      // Deleting one that isn't there is allowed (and does nothing), so that
      // deleting entries can always delete their submissions too.
      allow delete: if request.auth != null
                    && (resource == null || resource.data.uid == request.auth.uid);
    }

    // The devkit's heartbeat, public so that the site can show whether it's online.
    match /runner/status {
      allow read: if true;
      allow write: if isRunner();
    }

    // The devkit's account: an email/password user (devkit-runner@human-compiler.invalid),
    // made for the runner on 1 November 2026. Nobody else is the runner.
    function isRunner() {
      return request.auth != null && request.auth.uid == 'XuEZIuVLMGYbBfPNWOSHRAZbOIE2';
    }

    // Puzzle ids are slugs such as 'signal-boost' (see src/puzzle/puzzles.ts).
    function isValidPuzzleId(id) {
      return id.matches('[A-Za-z0-9_-]{1,64}');
    }

    // Mirrors submitOnlineScore(). The name limit matches the UI's
    // <input maxlength="20"> (trimmed, non-empty) in src/ui/leaderboard.ts;
    // codeSize is in bytes (whole 32-bit dwords); timestamp is Date.now() in
    // milliseconds, allowing up to a day of client clock skew.
    function isValidNewEntry(data) {
      let fields = ['uid', 'name', 'codeSize', 'vgprsUsed', 'cycles', 'timestamp'];
      return request.auth != null
        && data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.uid == request.auth.uid
        && data.name is string
        && data.name.size() <= 20
        && data.name.trim().size() > 0
        && data.codeSize is int
        && data.codeSize >= 4
        && data.codeSize <= 65536
        && data.codeSize % 4 == 0
        && data.vgprsUsed is int
        && data.vgprsUsed >= 1
        && data.vgprsUsed <= 256
        && data.cycles is int
        && data.cycles >= 1
        && data.cycles <= 10000000
        && data.timestamp is int
        && data.timestamp > 0
        && data.timestamp <= request.time.toMillis() + 24 * 60 * 60 * 1000;
    }

    // Mirrors the submission that submitOnlineScore() in
    // src/firebase/online-leaderboard.ts makes after the entry: the source of
    // the author's own entry, waiting for the devkit.
    function isValidSubmission(entryId, data) {
      let fields = ['uid', 'puzzleId', 'source', 'appVersion', 'puzzleHash', 'createdAt', 'status'];
      return request.auth != null
        && data.keys().hasAll(fields)
        && data.keys().hasOnly(fields)
        && data.uid == request.auth.uid
        && data.puzzleId is string
        && isValidPuzzleId(data.puzzleId)
        && data.source is string
        && data.source.size() > 0
        && data.source.size() <= 100000
        && data.appVersion is string
        && data.appVersion.matches('[0-9]{1,4}[.][0-9]{1,4}[.][0-9]{1,6}')
        && data.puzzleHash is string
        && data.puzzleHash.matches('[0-9a-f]{16}')
        && data.createdAt == request.time
        && data.status == 'pending'
        && isOwnEntry(data.puzzleId, entryId);
    }

    function isOwnEntry(puzzleId, entryId) {
      let path = /databases/$(database)/documents/leaderboards/$(puzzleId)/entries/$(entryId);
      return exists(path) && get(path).data.uid == request.auth.uid;
    }

    // What the devkit adds to an entry once it has timed the solution (the
    // measured fields of HwScore in src/hardware/protocol.ts), and submittedAt:
    // the submission's createdAt, which breaks ties on the board (the entry's
    // own timestamp is the player's clock).
    function isValidHardwareResult(hw) {
      return hw is map
        && hw.keys().hasAll(['cycles', 'harness', 'measuredAt', 'submittedAt'])
        && hw.keys().hasOnly(['cycles', 'perInvocation', 'emulatorMismatches', 'harness', 'measuredAt', 'submittedAt'])
        && hw.cycles is int
        && hw.cycles >= 0
        && hw.harness is int
        && hw.measuredAt is timestamp
        && hw.submittedAt is timestamp;
    }

    // Everything else is denied: there are no other allow rules.
  }
}
